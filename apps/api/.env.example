# Bu dosyayı .env olarak kopyalayın. .env asla git'e eklenmez.
VIA_ENVIRONMENT=local
VIA_DATABASE_URL=postgresql+psycopg://via:via_dev_password@localhost:5433/via
VIA_TEST_DATABASE_URL=postgresql+psycopg://via:via_dev_password@localhost:5433/via_test
# Canlı ortamda en az 32 karakterlik rastgele bir değer zorunludur.
VIA_SECRET_KEY=local-dev-only-secret-key-change-me-0123456789
VIA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
