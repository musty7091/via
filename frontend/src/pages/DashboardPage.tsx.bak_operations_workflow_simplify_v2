  onOpenFinanceCenter: () => void;
  onOpenUsers: () => void;
  onOpenExpenses?: () => void;
};

type WorkflowStep = {
  step: string;
  title: string;
  description: string;
  detail: string;
  actionLabel: string;
  tone: "dark" | "teal" | "slate" | "amber" | "emerald" | "indigo";
  onClick: () => void;
};

type PrincipleCard = {
  title: string;
  description: string;
};

