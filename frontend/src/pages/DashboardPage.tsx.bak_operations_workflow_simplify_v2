    title: "Finansı ayır",
    description:
      "Operasyon ekranı işi hazırlar; tahsilat, gider, cari ve kapanış Finans Merkezi’nde yürür.",
  },
];

function getWorkflowToneClass(tone: WorkflowStep["tone"]) {
  if (tone === "dark") {
    return {
      accent: "bg-slate-950 text-white",
      badge: "bg-slate-950 text-white",
      button: "text-slate-950",
    };
  }

  if (tone === "teal") {
    return {
      accent: "bg-teal-500 text-white",
      badge: "bg-teal-50 text-teal-700",
      button: "text-teal-700",
    };
  }

  if (tone === "amber") {
    return {
      accent: "bg-amber-400 text-slate-950",
      badge: "bg-amber-50 text-amber-700",
      button: "text-amber-700",
    };
  }

  if (tone === "emerald") {
    return {
      accent: "bg-emerald-500 text-white",
      badge: "bg-emerald-50 text-emerald-700",
      button: "text-emerald-700",
    };
  }

  if (tone === "indigo") {
    return {
      accent: "bg-indigo-500 text-white",
      badge: "bg-indigo-50 text-indigo-700",
      button: "text-indigo-700",
    };
  }

  return {
    accent: "bg-slate-200 text-slate-950",
    badge: "bg-slate-100 text-slate-600",
    button: "text-slate-700",
  };
}

