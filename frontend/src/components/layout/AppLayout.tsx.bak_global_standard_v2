import type { ReactNode } from "react";
import type { AuthUser } from "../../types/auth";

type AppLayoutMaxWidth = "standard" | "wide";

type AppLayoutAction = {
  label: string;
  onClick: () => void;
  variant?: "primary" | "secondary" | "ghost";
};

type AppLayoutProps = {
  title?: string;
  eyebrow?: string;
  subtitle?: string;
  badge?: string;
  user?: AuthUser | null;
  onLogout?: () => void;
  onBack?: () => void;
  backLabel?: string;
  actions?: AppLayoutAction[];
  maxWidth?: AppLayoutMaxWidth;
  children: ReactNode;
};

function getMaxWidthClass(maxWidth: AppLayoutMaxWidth | undefined) {
  return maxWidth === "standard" ? "max-w-6xl" : "max-w-7xl";
}

function getActionClass(variant: AppLayoutAction["variant"] = "primary") {
  if (variant === "secondary") {
    return "border border-slate-200 bg-white text-slate-700 hover:border-teal-200 hover:bg-teal-50";
  }

  if (variant === "ghost") {
    return "bg-transparent text-slate-500 hover:bg-slate-100 hover:text-slate-950";
  }

  return "bg-slate-950 text-white hover:bg-teal-700";
}

export function AppLayout(props: AppLayoutProps) {
  const {
    user,
    onLogout,
    onBack,
    backLabel = "Geri Dön",
    actions = [],
    maxWidth = "wide",
    children,
  } = props;

  const maxWidthClass = getMaxWidthClass(maxWidth);

  return (
    <main className="min-h-screen bg-slate-50 text-slate-950">
      <header className="select-none cursor-default" className="sticky top-0 z-30 border-b border-slate-200 bg-white/95 px-5 py-3 backdrop-blur">
        <div className={`mx-auto flex w-full ${maxWidthClass} items-center justify-between gap-4`}>
          <div className="flex min-w-0 items-center gap-3">
            {onBack ? (
              <button
                type="button"
                onClick={onBack}
                className="rounded-full border border-slate-200 bg-white px-3 py-2 text-xs font-black text-slate-600 shadow-sm transition hover:border-teal-200 hover:bg-teal-50 hover:text-teal-700"
              >
                ← {backLabel}
              </button>
            ) : null}

            <img draggable={false}
              src="/brand/via-logo-horizontal.png"
              alt="VIA EVENTS"
              className="h-9 w-auto object-contain sm:h-10"
            />
          </div>

          <div className="flex shrink-0 items-center gap-2">
            {actions.map((action) => (
              <button
                key={action.label}
                type="button"
                onClick={action.onClick}
                className={`rounded-full px-4 py-2 text-sm font-black shadow-sm transition ${getActionClass(
                  action.variant
                )}`}
              >
                {action.label}
              </button>
            ))}

            {user ? (
              <div className="hidden rounded-2xl border border-slate-200 bg-slate-50 px-4 py-2 text-right sm:block">
                <p className="text-[11px] font-black uppercase tracking-[0.18em] text-slate-400">
                  Oturum
                </p>
                <p className="mt-0.5 max-w-[10rem] truncate text-sm font-black text-slate-950">
                  {user.full_name}
                </p>
              </div>
            ) : null}

            {onLogout ? (
              <button
                type="button"
                onClick={onLogout}
                className="rounded-full bg-slate-950 px-4 py-2 text-sm font-black text-white shadow-sm transition hover:bg-slate-800"
              >
                Çıkış
              </button>
            ) : null}
          </div>
        </div>
      </header>

      <section className={`mx-auto w-full ${maxWidthClass} px-5 py-6`}>{children}</section>

      <footer className="border-t border-slate-200 bg-slate-50 px-5 py-5 text-center text-xs font-semibold text-slate-400">
        © 2026 VIA EVENTS. Tüm hakları saklıdır.
      </footer>
    </main>
  );
}