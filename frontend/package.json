    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "globals": "^15.9.0",
    "jsdom": "^25.0.0",
    "prettier": "^3.3.3",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
